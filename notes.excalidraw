      "versionNonce": 958239833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784094874898,
      "link": null,
      "locked": false,
      "text": "{\n  \"success\": true,\n  \"report\": {\n    \"aircraft\": \"AIR-001\",\n    \"aircraft_model\": \"A321neo\",\n    \"health_status\": \"GROUND AIRCRAFT\",\n    \"risk_level\": \"CRITICAL\",\n    \"safe_for_next_flight\": false,\n    \"final_flight_decision\": {\n      \"decision\": \"GROUND_AIRCRAFT\",\n      \"can_fly_now\": false,\n      \"ui_statement\": \"The aircraft is grounded due to critical threshold violations in engine temperature, \n        exhaust gas temperature, oil temperature, oil pressure, and engine vibration.\",\n      \"required_before_next_flight\": \"Immediate maintenance actions required.\",\n      \"decision_rationale\": \"Multiple critical threshold violations detected, indicating\n       potential severe engine issues.\"\n    },\n    \"overall_summary\": \"The aircraft has exceeded critical thresholds in multiple parameters, \n    including engine temperature, exhaust gas temperature, oil temperature, oil pressure, and engine vibration.\n    Immediate maintenance is required before the aircraft can be considered safe for flight.\",\n    \"threshold_violations\": [\n      {\n        \"parameter\": \"Engine_Temperature\",\n        \"observed_value\": 1500,\n        \"manual_threshold\": \"> 696°C\",\n        \"severity\": \"CRITICAL\",\n        \"manual_reference\": \"Chapter 3, Table 3.1\",\n        \"explanation\": \"Engine temperature has exceeded the critical threshold, indicating a potential \n        severe engine issue.\"\n      },\n    ],\n    \"root_cause\": {\n      \"most_likely_cause\": \"Unknown\",\n      \"supporting_evidence\": [\n        \"Multiple critical threshold violations detected.\",\n        \"No specific root cause identified in the manual for the given parameters.\"\n      ],\n      \"manual_reference\": \"Chapter 5, Table 5.1\"\n    },\n    \"maintenance_actions\": [\n      {\n        \"priority\": 1,\n        \"action\": \"Inspect cooling air ducts and combustion liner\",\n        \"reason\": \"Engine temperature exceeded critical threshold.\",\n        \"manual_reference\": \"Chapter 3, Table 3.1\"\n      },\n    ],\n    \"inspection_checklist\": [\n      {\n        \"step\": 1,\n        \"inspection_item\": \"Visual leak check, fluid stains, foreign object damage\",\n        \"acceptance_criteria\": \"No leaks, no foreign object damage\",\n        \"manual_reference\": \"Chapter 6, Section 6.1\"\n      },\n    ],\n    \"work_order\": {\n      \"title\": \"Immediate Maintenance Required\",\n      \"aircraft_id\": \"AIR-001\",\n      \"work_order_type\": \"REPAIR\",\n      \"priority\": \"CRITICAL\",\n      \"tasks\": [\n        \"Inspect and replace affected components as per maintenance actions.\",\n        \"Perform root cause analysis to determine the cause of threshold violations.\"\n      ],\n      \"required_parts_or_tools\": [\n        \"Replacement bearings\",\n        \"Oil cooler and scavenge lines\",\n        \"Oil pump, filter, and seals\",\n        \"Borescope tool\"\n      ],\n      \"estimated_maintenance_category\": \"Unscheduled Maintenance\"\n    },\n    \"confidence\": {\n      \"score\": 0.8,\n      \"rationale\": \"Based on multiple critical threshold violations and the severity of the detected issues.\",\n      \"missing_information\": [\n        \"Specific root cause for the threshold violations is not identified in the manual.\"\n      ]\n    }\n  }\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"success\": true,\n  \"report\": {\n    \"aircraft\": \"AIR-001\",\n    \"aircraft_model\": \"A321neo\",\n    \"health_status\": \"GROUND AIRCRAFT\",\n    \"risk_level\": \"CRITICAL\",\n    \"safe_for_next_flight\": false,\n    \"final_flight_decision\": {\n      \"decision\": \"GROUND_AIRCRAFT\",\n      \"can_fly_now\": false,\n      \"ui_statement\": \"The aircraft is grounded due to critical threshold violations in engine temperature, \n        exhaust gas temperature, oil temperature, oil pressure, and engine vibration.\",\n      \"required_before_next_flight\": \"Immediate maintenance actions required.\",\n      \"decision_rationale\": \"Multiple critical threshold violations detected, indicating\n       potential severe engine issues.\"\n    },\n    \"overall_summary\": \"The aircraft has exceeded critical thresholds in multiple parameters, \n    including engine temperature, exhaust gas temperature, oil temperature, oil pressure, and engine vibration.\n    Immediate maintenance is required before the aircraft can be considered safe for flight.\",\n    \"threshold_violations\": [\n      {\n        \"parameter\": \"Engine_Temperature\",\n        \"observed_value\": 1500,\n        \"manual_threshold\": \"> 696°C\",\n        \"severity\": \"CRITICAL\",\n        \"manual_reference\": \"Chapter 3, Table 3.1\",\n        \"explanation\": \"Engine temperature has exceeded the critical threshold, indicating a potential \n        severe engine issue.\"\n      },\n    ],\n    \"root_cause\": {\n      \"most_likely_cause\": \"Unknown\",\n      \"supporting_evidence\": [\n        \"Multiple critical threshold violations detected.\",\n        \"No specific root cause identified in the manual for the given parameters.\"\n      ],\n      \"manual_reference\": \"Chapter 5, Table 5.1\"\n    },\n    \"maintenance_actions\": [\n      {\n        \"priority\": 1,\n        \"action\": \"Inspect cooling air ducts and combustion liner\",\n        \"reason\": \"Engine temperature exceeded critical threshold.\",\n        \"manual_reference\": \"Chapter 3, Table 3.1\"\n      },\n    ],\n    \"inspection_checklist\": [\n      {\n        \"step\": 1,\n        \"inspection_item\": \"Visual leak check, fluid stains, foreign object damage\",\n        \"acceptance_criteria\": \"No leaks, no foreign object damage\",\n        \"manual_reference\": \"Chapter 6, Section 6.1\"\n      },\n    ],\n    \"work_order\": {\n      \"title\": \"Immediate Maintenance Required\",\n      \"aircraft_id\": \"AIR-001\",\n      \"work_order_type\": \"REPAIR\",\n      \"priority\": \"CRITICAL\",\n      \"tasks\": [\n        \"Inspect and replace affected components as per maintenance actions.\",\n        \"Perform root cause analysis to determine the cause of threshold violations.\"\n      ],\n      \"required_parts_or_tools\": [\n        \"Replacement bearings\",\n        \"Oil cooler and scavenge lines\",\n        \"Oil pump, filter, and seals\",\n        \"Borescope tool\"\n      ],\n      \"estimated_maintenance_category\": \"Unscheduled Maintenance\"\n    },\n    \"confidence\": {\n      \"score\": 0.8,\n      \"rationale\": \"Based on multiple critical threshold violations and the severity of the detected issues.\",\n      \"missing_information\": [\n        \"Specific root cause for the threshold violations is not identified in the manual.\"\n      ]\n    }\n  }\n}",
